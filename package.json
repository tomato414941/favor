{
  "name": "favor",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch-path=src/server --watch-path=server.mjs server.mjs",
    "build": "react-router build",
    "start": "node server.mjs",
    "typecheck": "react-router typegen && tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build -- --logLevel warn && node scripts/browser.mjs",
    "check": "npm run format:check && npm run typecheck && npm run build -- --logLevel warn && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"app/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" server.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"app/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" server.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.20.0",
    "@clerk/localizations": "^4.19.0",
    "@clerk/react-router": "^3.6.27",
    "@react-router/node": "^8.4.0",
    "@remix-run/node-fetch-server": "^0.14.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@react-router/dev": "^8.4.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
