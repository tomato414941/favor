{
  "name": "commission",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.14.0 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --import tsx --env-file-if-exists=.env.local src/server/main.ts --demo",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env.local dist/server/server/main.js --demo",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "python3 tests/browser.py",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
