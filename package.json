{
  "name": "favor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --import ./scripts/env.mjs --import tsx src/server/main.ts --demo",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --import ./scripts/env.mjs dist/server/server/main.js --demo",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "npm run build -- --logLevel warn && python3 tests/browser_cookie_isolation.py && node scripts/browser.mjs && node scripts/browser.mjs --x",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"client/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"client/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
