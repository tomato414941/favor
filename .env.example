# Keep credentials in .env.local (ignored by git), never in client/VITE_* variables.
# email: email verification. demo: fixed accounts. x: optional X login.
FAVOR_AUTH_MODE=email

# Must match the browser origin exactly, with no trailing slash.
FAVOR_PUBLIC_ORIGIN=http://127.0.0.1:3211

# OAuth 2.0 credentials for a confidential Web App, not OAuth 1.0a API keys.
# Register <FAVOR_PUBLIC_ORIGIN>/api/auth/x/callback as the app's callback URL.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Defaults: 3210 for the API; data/ for email/demo, data/x-sandbox/ for X identities.
# FAVOR_PORT=3210
# FAVOR_DATA_DIR=data/x-sandbox

# file: local development only; messages are saved privately under data/mail/.
# Public deployments require resend and a verified sender domain.
FAVOR_MAIL_DELIVERY=file
# RESEND_API_KEY=
# FAVOR_EMAIL_FROM=Favor <login@example.com>

# Reserved .test domain whose verification codes are saved under data/mail/ instead of being sent.
# Staging uses it for sample accounts; leave unset to send every address through the provider.
# FAVOR_TEST_MAIL_DOMAIN=favor.test
