# Keep credentials in .env.local (ignored by git), never in client/VITE_* variables.
# clerk: sign-in through Clerk. demo: local sign-in by address (loopback only, no provider).
FAVOR_AUTH_MODE=demo
FAVOR_PAYMENT_MODE=mock

# FAVOR_PAYMENT_MODE=stripe_test
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_ACCOUNT_ID=
# Live payments: use stripe_live, rk_live_* and live Clerk keys, with a fresh FAVOR_DATA_DIR.
# FAVOR_PUBLIC_PROFILE is JSON with businessType (individual/company), email, contactHours,
# discloseOnRequest, name, address and phone. Companies also require representative.
# Only a sole proprietor choosing discloseOnRequest=true may omit name/address/phone;
# the contact address must accept requests and provide the details before purchase.
# Leave unset until the operator has approved the information for publication.
# FAVOR_PUBLIC_PROFILE=

# Clerk keys for FAVOR_AUTH_MODE=clerk (Dashboard -> Configure -> API keys).
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Must match the browser origin exactly, with no trailing slash.
FAVOR_PUBLIC_ORIGIN=http://127.0.0.1:3211

# Defaults: 3210 for the API; data/ for the database and mail.
# FAVOR_PORT=3210
# FAVOR_DATA_DIR=data

# file: local development only; messages are saved privately under data/mail/.
# Public deployments require resend and a verified sender domain.
FAVOR_MAIL_DELIVERY=file
# RESEND_API_KEY=
# FAVOR_EMAIL_FROM=Favor <login@example.com>

# Reserved .test domain whose verification codes are saved under data/mail/ instead of being sent.
# Staging uses it for sample accounts; leave unset to send every address through the provider.
# FAVOR_TEST_MAIL_DOMAIN=favor.test
