# Keep credentials in .env.local (ignored by git), never in client/VITE_* variables.
# local: email/password. demo: fixed accounts. x: optional X login.
COMMISSION_AUTH_MODE=local

# Must match the browser origin exactly, with no trailing slash.
COMMISSION_PUBLIC_ORIGIN=http://127.0.0.1:3211

# OAuth 2.0 credentials for a confidential Web App, not OAuth 1.0a API keys.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Defaults: 3210 for the API; data/ for demo, data/x-sandbox/ for X identities.
# COMMISSION_PORT=3210
# COMMISSION_DATA_DIR=data/x-sandbox
